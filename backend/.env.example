# ========================================================
# 🤖 AI PORTFOLIO API - CONFIGURATION
# Copy this file to .env and update the values.
# ========================================================

# --------------------------------------------------------
# 1. PORTFOLIO IDENTITY
# The AI adopts this persona. Change these to make it yours.
# --------------------------------------------------------
PORTFOLIO_OWNER="Roy Amit"
# URL to your PDF resume (e.g., hosted in your Vercel public folder)
RESUME_LINK="https://your-frontend.vercel.app/resume.pdf"


# --------------------------------------------------------
# 2. SECURITY & NETWORKING
# --------------------------------------------------------
# Comma-separated list of allowed frontend domains
CORS_ORIGINS="http://localhost:3000,https://your-project.vercel.app"
ENVIRONMENT="development"


# --------------------------------------------------------
# 3. DATABASE (PostgreSQL with pgvector)
# --------------------------------------------------------
# [Docker Local] These defaults work with docker-compose.yml
DATABASE_URL="postgresql+psycopg://postgres:password@postgres:5432/portfolio_db"
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=portfolio_db

# [Production] Replace DATABASE_URL with your Neon/Supabase connection string
# DATABASE_URL="postgresql://user:pass@host.neon.tech/dbname"


# --------------------------------------------------------
# 4. AI ENGINE (OpenAI)
# --------------------------------------------------------
# Required: Get your API key from https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o-mini"

# Change the version suffix (e.g., _v2) to force a fresh re-index
VECTOR_DB_COLLECTION="portfolio_documents_v2"


# --------------------------------------------------------
# 5. CACHING (Redis)
# --------------------------------------------------------
# [Docker Local] These defaults work with docker-compose.yml
REDIS_URL="redis://redis:6379"
REDIS_HOST=redis
REDIS_PORT=6379

# [Production] Replace with your Upstash/Render Redis URL
# REDIS_URL="rediss://default:password@your-redis.upstash.io:6379"


# --------------------------------------------------------
# 6. EMAIL SERVICE (SMTP)
# Required for the "Send Resume" feature.
# --------------------------------------------------------
MAIL_SERVER="smtp.gmail.com"
MAIL_PORT=587
MAIL_USERNAME="your.email@gmail.com"
# For Gmail, generate an 'App Password' (not your login password)
MAIL_PASSWORD="your_app_password"
MAIL_FROM="your.email@gmail.com"
# Where you want to receive "Contact Me" form submissions
OWNER_EMAIL="your.email@gmail.com"


# --------------------------------------------------------
# 7. SOCIAL DATA (Optional)
# Used for fetching dynamic content from your profiles.
# --------------------------------------------------------
GITHUB_USERNAME="your_username"
GITHUB_TOKEN="your_github_token"
LINKEDIN_USERNAME="your_username"
DEVTO_USERNAME="your_username"
USER_AGENT="PortfolioBot/1.0"


# --------------------------------------------------------
# 8. DEBUGGING (LangSmith)
# Optional: Set to 'true' to trace AI reasoning steps.
# --------------------------------------------------------
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT="https://api.smith.langchain.com"
LANGCHAIN_API_KEY="your_langchain_key"