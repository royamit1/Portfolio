# -----------------------------------------------------------------------------
# EXAMPLE .env FILE
#
# Copy this file to a new file named '.env' in the same directory.
# Then, fill in your actual credentials.
# This .env file is for local development and is used by docker-compose.
# For production (e.g., Render, AWS), you will set these as environment variables
# in your hosting provider's dashboard.
# -----------------------------------------------------------------------------

# --- Project Settings ---
PROJECT_NAME="My AI Portfolio"

# --- Security ---
# List of frontend URLs allowed to access the API (JSON format)
# IMPORTANT: For production, replace localhost with your actual frontend domain.
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173"]'

# --- 4. AI Engine (OpenAI) ---
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-4-turbo

# Change this name (e.g., _v2) to force the app to re-read your 'app/data' files.
VECTOR_DB_COLLECTION=portfolio_documents_v1

# --- 5. Caching (Redis / Upstash) ---
# [Production] Paste the URL from Upstash or Render Redis.
# Format: redis://default:password@fly-xyz.upstash.io:6379
REDIS_URL=redis://default:password@fly-xyz.upstash.io:6379

# --- 6. Email Service (SMTP) ---
# Required for the "Send Resume" tool.
# For Gmail, you must use an "App Password" (not your login password).
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your.email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_FROM=your.email@gmail.com
# The email address that will receive "Contact Me" form submissions.
OWNER_EMAIL=your.email@gmail.com

# --- 7. Social Data (Optional) ---
# Used if you enable dynamic fetching of your projects/articles.
GITHUB_USERNAME=your_username
GITHUB_TOKEN=your_github_token
LINKEDIN_USERNAME=your_username
DEVTO_USERNAME=your_username
USER_AGENT=PortfolioBot/1.0

# --- 8. Debugging (LangSmith) ---
# Optional: Set to 'true' to trace AI reasoning steps.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langchain_key