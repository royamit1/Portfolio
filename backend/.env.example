# Database Configuration
DATABASE_URL=postgresql://portfolio_user:portfolio_password@localhost:5432/portfolio_db

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# GitHub Configuration
GITHUB_USERNAME=your_github_username_here
GITHUB_TOKEN=ghp_your_github_personal_access_token_here

# AI Service Configuration (choose one)
OPENAI_API_KEY=sk-your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GOOGLE_API_KEY=your_google_gemini_api_key_here

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Configuration
APP_NAME=Name's AI Portfolio
ENVIRONMENT=development

# Optional: CORS Configuration
FRONTEND_URL=http://localhost:5173

# Optional: Email Configuration (for contact forms later)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_app_password_here

# Optional: Analytics/Monitoring
# SENTRY_DSN=your_sentry_dsn_here